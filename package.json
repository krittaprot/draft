{
  "name": "tandem",
  "version": "0.1.0",
  "description": "The self-hosted design canvas for you and your AI agents: Claude Code, Codex and opencode design over MCP while you watch, edit by hand and review.",
  "license": "MIT",
  "author": "Krittaprot",
  "homepage": "https://github.com/krittaprot/tandem#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krittaprot/tandem.git"
  },
  "bugs": {
    "url": "https://github.com/krittaprot/tandem/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-tool",
    "canvas",
    "self-hosted",
    "ai-agents",
    "claude-code",
    "codex",
    "opencode",
    "figma-alternative",
    "pwa"
  ],
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "bin": {
    "tandem": "bin/tandem.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "start": "node dist/server.js serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-js": "2.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "geist": "^1.7.2",
    "typescript": "^5.9.0"
  }
}
