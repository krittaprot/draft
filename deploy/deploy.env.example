# Copy to deploy/deploy.env (git-ignored) and adjust. Read by scripts/deploy.sh, install-service.sh and setup-tunnel.sh.
TANDEM_LABEL=com.example.tandem          # launchd label prefix: <label>.server, <label>.tunnel
TANDEM_HOSTNAME=tandem.example.com       # public hostname served through the Cloudflare tunnel
TANDEM_PORT=3290                         # loopback port the server listens on
TANDEM_METRICS_PORT=20290                # cloudflared metrics port (loopback)
TANDEM_TUNNEL=tandem                     # Cloudflare tunnel name
# TANDEM_NODE=/opt/homebrew/bin/node     # Node binary for launchd (default: the node on PATH)
